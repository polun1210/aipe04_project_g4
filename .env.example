# 複製成 .env 後填入自己的值。.env 已被 .gitignore 排除，金鑰絕不進 repo。

# ── 辨識模組（E）：scripts/record_engines.py 錄製時使用 ──
# Cloud Vision：填 API 金鑰；不填時改用 Google 預設憑證（GOOGLE_APPLICATION_CREDENTIALS 指向服務帳戶 JSON）
GOOGLE_CLOUD_VISION_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# 不填就用 builtin/stable
CLOUD_VISION_MODEL=builtin/stable
# Gemini（Google AI Studio 金鑰）
GEMINI_API_KEY=
# 必填，沒有預設值：預設型號可能過時或被服務端換掉，結果就無法追溯。型號以 AI Studio 列出的正式 ID 為準
GEMINI_MODEL=gemini-3.5-flash-lite

# 辨識服務切換：stub（假資料，開發與測試用）或 openrouter（真辨識）。部署一定要設成 openrouter
# 不會因為沒設金鑰就自動改用假資料，假草稿看起來跟真的一樣，忘了設定不會有人發現
EXTRACTOR=stub

# OpenRouter（VLM 主路線：Gemini 3.8 Flash）
OPENROUTER_API_KEY=
# 必填，沒有預設值：型號要寫完整版本，不用會自動指向新版的名稱
OPENROUTER_MODEL=google/gemini-3.8-flash
# 必填：只由這個服務商處理。同一型號換到其他服務商，正確率可能明顯下降
OPENROUTER_PROVIDER=google-ai-studio
# 選填，兩個要一起設：主型號遇到 503／500／逾時等暫時性錯誤時改呼叫
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_FALLBACK_PROVIDER=

# 報告敘述（LLM）切換：template（不呼叫 LLM，用固定模板）或 openrouter。金鑰沿用 OPENROUTER_API_KEY
NARRATOR=template
# NARRATOR=openrouter 時必填，程式沒有預設值；下面是 ADR-0011 選定的值
NARRATOR_MODEL=anthropic/claude-haiku-5.5
NARRATOR_PROVIDER=anthropic

# 登入切換：test（預設，固定測試帳號，開發與 CI 用）或 google
AUTH=test
# AUTH=google 時必填。Client ID 向組長拿；不要 commit 真值
GOOGLE_CLIENT_ID=
# AUTH=google 時必填。產生方式：uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# 部署在 HTTPS 時設 true
SESSION_HTTPS_ONLY=false

# ── 資料庫（docs/database.md）──
# docker compose 會用這三個值建資料庫；DATABASE_URL（本機跑 uv run 時用）要跟它們一致
# 密碼請用英數字，不要含 @ : / # 等會破壞網址的符號。全系統容器部署時 compose 會自動改用容器內位址（見 docs/deploy.md）
POSTGRES_USER=g4
POSTGRES_PASSWORD=
POSTGRES_DB=g4
DATABASE_URL=postgresql://g4:<POSTGRES_PASSWORD>@127.0.0.1:5433/g4
# 對外連接埠（只綁 127.0.0.1）：資料庫、前端。多套環境並存時才需要改
# DB_PORT=5433
# FRONTEND_PORT=8080
# RAG 語料 ingest 與檢索用的 embedding 型號（金鑰沿用 OPENROUTER_API_KEY）。必填，程式沒有預設值，沒設 ingest 會報錯；下面是 ADR-0013 選定的值
# 換型號後要重跑 uv run python -m app.rag.ingest（舊型號的向量會整批重算）
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# 參考資料來源：csv（預設，讀 data/catalog/，不需要資料庫）或 pg（讀 catalog.v_* view）
# 本機直接跑 uv run 時用這個值；docker compose 的 backend 固定用 pg，不看這裡
CATALOG_SOURCE=csv
# 使用者資料存放：memory（預設，重啟就清空，不需要資料庫）或 pg（寫進 app schema，需要 DATABASE_URL）
# 本機直接跑 uv run 時用這個值；docker compose 的 backend 固定用 pg，不看這裡
STORE=memory

# 複製成 .env 後填入自己的值。.env 已被 .gitignore 排除，金鑰絕不進 repo。

# ── 辨識模組（E）：scripts/record_engines.py 錄製時使用 ──
# Cloud Vision：填 API 金鑰；不填時改用 Google 預設憑證（GOOGLE_APPLICATION_CREDENTIALS 指向服務帳戶 JSON）
GOOGLE_CLOUD_VISION_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# 不填就用 builtin/stable
CLOUD_VISION_MODEL=builtin/stable
# Gemini（Google AI Studio 金鑰）
GEMINI_API_KEY=
# 不填就用 gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

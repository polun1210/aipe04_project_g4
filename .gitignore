# Python 執行時自動產生的暫存
__pycache__/
*.pyc

# 每個人本機的虛擬環境
.venv/

# 工具的快取
.pytest_cache/
.ruff_cache/

# 金鑰與環境變數；範本檔可以進 Git
.env
.env.*
!.env.example

# 本機 SQLite 資料庫
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# 前端產生的檔案
node_modules/
dist/

# 作業系統與編輯器產生的檔案
.DS_Store
Thumbs.db
.idea/
.vscode/

# 有版權的標示照片，只留本機
/data/

# 引擎原始回應，只留本機
tests/fixtures/engine_responses/*/raw/

# Claude Code 個人設定
.claude/settings.local.json